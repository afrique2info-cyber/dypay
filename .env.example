# Supabase - Obligatoire
# URL de votre projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Cle anonyme Supabase (publique, sure cote client)
VITE_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Monetbil - Obligatoire pour les paiements
# Cle de service Monetbil pour l'integration Mobile Money
VITE_MONETBIL_SERVICE_KEY=votre_cle_monetbil_service

# ============================================
# VARIABLES SERVEUR (Edge Functions Supabase)
# ============================================
# Ces variables sont configurees dans Supabase Dashboard > Edge Functions > Secrets
# Ne les ajoutez PAS dans ce fichier .env

# SUPABASE_URL          - Automatiquement disponible
# SUPABASE_ANON_KEY     - Automatiquement disponible
# SUPABASE_SERVICE_ROLE_KEY - Automatiquement disponible
# SUPABASE_DB_URL       - Automatiquement disponible
# MONETBIL_SERVICE_KEY  - A configurer manuellement dans les secrets
# FASTFOREX_API_KEY     - A configurer manuellement dans les secrets (optionnel)
